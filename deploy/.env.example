# Скопируйте в deploy/.env и заполните. Файл .env НЕ коммитится в git.

# --- Адрес и доступ ---
DOMAIN=office.example.com
PUBLIC_URL=https://office.example.com
# Длинный случайный токен для входа в пульт: openssl rand -hex 32
DIRECTOR_TOKEN=

# --- Claude API (https://console.anthropic.com → API Keys) ---
ANTHROPIC_API_KEY=
MODEL_WORKER=claude-sonnet-5-5
MODEL_LEAD=claude-opus-5-5
# Цены за 1 млн токенов в USD — сверьте с https://www.anthropic.com/pricing
PRICE_IN_WORKER=3
PRICE_OUT_WORKER=15
PRICE_IN_LEAD=15
PRICE_OUT_LEAD=75

# --- Деньги и лимиты (в базовой валюте) ---
BASE_CURRENCY=EUR
FX_RUB_PER_EUR=100
FX_USD_PER_EUR=1.08
# Траты, которые агенты делают сами. Выше — только после вашего «да».
LIMIT_PER_ACTION=50
LIMIT_DAILY=100
LIMIT_MONTHLY=1000
# Потолок расходов на Claude API (защита от зацикливания)
LIMIT_LLM_DAILY=20
LIMIT_LLM_MONTHLY=300
# Сколько писем/постов агенты отправляют сами за сутки
LIMIT_OUTBOUND_DAILY=40

# --- Работа агентов ---
WORKER_CONCURRENCY=2
# Рабочие часы агентов (00:00–24:00 = круглосуточно)
WORK_START=00:00
WORK_END=24:00
TZ=Europe/Vilnius

# --- Telegram: подтверждения и отчёты (бот создаётся у @BotFather) ---
TELEGRAM_BOT_TOKEN=
# Ваш chat id: напишите боту @userinfobot
TELEGRAM_DIRECTOR_CHAT_ID=
# Кабинет директора в Telegram открывается по адресу PUBLIC_URL/tg (нужен https)
# Канал для постов агентов (бот должен быть админом канала), например @neurosfera_news
TELEGRAM_CHANNEL_ID=

# --- Stripe (ЕС/международно) ---
STRIPE_SECRET_KEY=
# Вебхук: https://ДОМЕН/webhooks/stripe, события checkout.session.completed, invoice.paid, charge.refunded
STRIPE_WEBHOOK_SECRET=

# --- ЮKassa (РФ) ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Секрет в адресе уведомлений: https://ДОМЕН/webhooks/yookassa?k=ЭТО_ЗНАЧЕНИЕ
YOOKASSA_WEBHOOK_KEY=
# Чеки 54-ФЗ через ЮKassa (1 = включить); код НДС: 1 — без НДС (сверьте с бухгалтером)
YOOKASSA_RECEIPTS=0
YOOKASSA_VAT_CODE=1

# --- Revolut Business: карта под каждую трату + выписки (инструкция: docs/FINANCE.md) ---
REVOLUT_ENV=production
REVOLUT_CLIENT_ID=
# Домен из Redirect URI, указанного в настройках API Revolut (например office.example.com)
REVOLUT_JWT_ISS=
# Приватный ключ лежит в deploy/secrets/revolut.pem (папка не коммитится)
REVOLUT_PRIVATE_KEY_PATH=/secrets/revolut.pem
REVOLUT_REFRESH_TOKEN=
# Основная валюта бизнеса в Revolut (лимиты карт задаются в ней)
REVOLUT_CARD_CURRENCY=EUR
# ID участников команды Revolut, которые видят карты в приложении (через запятую, до 5)
REVOLUT_CARD_CONTACT_IDS=
# ID субсчёта «Агенты», с которого списывают карты (рекомендуется; GET /accounts в Revolut API)
REVOLUT_CARD_ACCOUNT_IDS=
# Срок жизни карты под трату (дней) и закрытие карты сразу после списания (1/0)
REVOLUT_CARD_DAYS=14
REVOLUT_TERMINATE_AFTER_USE=1

# --- Paysera: выписки и остатки (персональный токен только на чтение) ---
PAYSERA_TOKEN=
# Номер счёта вида EVP1234567890 (можно несколько через запятую)
PAYSERA_ACCOUNT=

# --- Технологическая разведка (docs/TECH-RADAR.md) ---
# Токен GitHub только на чтение публичных данных — снимает лимит запросов (необязательно)
GITHUB_TOKEN=
# Свои RSS/Atom-ленты через запятую (пусто — стандартный список)
RADAR_FEEDS=
RADAR_GITHUB_TOPICS=llm,ai-agents,mcp,claude,rag,agentic-ai
RADAR_HN_MIN_POINTS=80
RADAR_DAILY_ITEMS=40
# Веб-поиск Claude для разведки, R&D, аналитики и безопасности (0 — выключить)
RADAR_WEB_SEARCH=1
# Цена веб-поиска за 1000 запросов, USD — сверьте на anthropic.com/pricing
PRICE_WEB_SEARCH=10

# --- AgentMail: почта агентов ---
AGENTMAIL_API_KEY=

# --- Деплой продуктов (хук Coolify/Render/Vercel), выполняется только после вашего «да» ---
DEPLOY_WEBHOOK_URL=

# --- Маркетинг: рекламные кабинеты и соцсети (docs/MARKETING.md) ---
# Meta (Facebook/Instagram Ads): токен системного пользователя Business Manager с правом ads_management
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_
META_PAGE_ID=
META_CURRENCY=EUR
META_API_VERSION=v23.0
# Google Ads API: developer token, OAuth-клиент и refresh token пользователя с доступом к аккаунту
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CURRENCY=EUR
GOOGLE_ADS_API_VERSION=v21
# --- Соцсети компании: публикуют агенты (права — в пульте, «Маркетинг» → «Права агентов») ---
# Telegram: канал компании и чаты, куда боту разрешено писать (ID через запятую)
TELEGRAM_CHANNEL_ID=
TELEGRAM_COMMUNITY_CHATS=
# Instagram (профессиональный, связан со страницей Facebook; страница — META_PAGE_ID выше)
IG_USER_ID=
IG_ACCESS_TOKEN=
# Threads (токен сервер продлевает сам каждый понедельник)
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
# LinkedIn: страница компании; токен живёт 60 дней — укажите дату окончания, бот напомнит за неделю
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_URN=urn:li:organization:
LINKEDIN_TOKEN_EXPIRES=
LINKEDIN_VERSION=202510
# X (Twitter): ключи приложения и токен аккаунта компании (OAuth 1.0a)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# Reddit: аккаунт компании и приложение типа script
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
# ВКонтакте: сообщество и его ключ доступа
VK_GROUP_ID=
VK_ACCESS_TOKEN=
# Как часто забирать статистику из кабинетов (часов)
MK_SYNC_HOURS=3
